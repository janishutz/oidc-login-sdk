        "outDir": "./dist",
        "rootDir": "./src",
        "allowJs": true,
        "target": "ES2022",
        "skipLibCheck": true,
        "allowSyntheticDefaultImports": true,
        "module": "NodeNext",
        "moduleResolution": "NodeNext"
